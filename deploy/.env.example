# أسرار الموقع — انسخه إلى deploy/.env واملأه. لا يدخل المستودع أبداً.

# openssl rand -base64 48
SECRET_KEY=

# رابط Neon الكامل (من لوحة Neon أو Render ← Environment)
# postgresql://user:pass@ep-xxx.region.aws.neon.tech/wtn_db?sslmode=require
DATABASE_URL=

# النطاقات المسموح بها — كان "*" على Render، وهو مفتوحٌ لكل عنوان
# `web` هو اسم الموقع **داخل شبكة Docker** — ينادي به البوت. بدونه يردّ
# Django بـ 400 على كل نبضة، والرسالة لا تقول أن الاسم هو السبب.
ALLOWED_HOSTS=wtn4.com,www.wtn4.com,api.wtn4.com,46.224.47.213,web,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://wtn4.com,https://www.wtn4.com,https://api.wtn4.com

DEBUG=0

# السرّ المشترك مع بوت واتساب — openssl rand -hex 32
# بدونه تبقى الواجهة الداخلية مغلقة 503، وهو السلوك المقصود
INTERNAL_API_KEY=
