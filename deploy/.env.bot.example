# أسرار بوت واتساب — انسخه إلى deploy/.env.bot

# عنوان الموقع **داخل شبكة Docker** لا على الإنترنت.
#
# `https://wtn4.com` يخرج من الحاوية إلى الإنترنت ثم يعود إلى الخادم نفسه —
# وهو طريقٌ يفشل على أكثر المستضيفات (لا يُسمح للخادم بمناداة عنوانه العام
# من داخله). والداخليّ أسرع ولا يمرّ بالشهادة ولا يستهلك حزمة.
SITE_URL=http://web:8000

# نفس القيمة الموضوعة في deploy/.env
INTERNAL_API_KEY=

# cd bot && npm run keygen — مرّةً واحدة.
# إن ضاع فُقدت كل جلسات واتساب ولزم مسح QR من جديد. احتفظ بنسخة خارج الخادم.
BOT_ENCRYPTION_KEY=
