# الموجّه: يستقبل الطلبات ويمرّرها إلى الموقع، ويصنع شهادة HTTPS وحده
# ويجدّدها وحده — بلا خطوة يدوية تُنسى بعد تسعين يوماً.

{
	# بريدٌ لتنبيهات الشهادة من Let's Encrypt
	email alayatl.tr@gmail.com
}

wtn4.com, www.wtn4.com, api.wtn4.com {
	encode zstd gzip

	# الردود على `/client/api/` تخصّ عملاء خارجيين لا متصفّحات، ولا تُخزَّن
	header /client/api/* Cache-Control "no-store"

	reverse_proxy web:8000 {
		# بدونهما يرى Django عنوان الموجّه لا عنوان الزائر، ويظنّ الاتصال
		# غير مشفّر فيعيد التوجيه إلى https إلى ما لا نهاية.
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}

# النطاقات الفرعية للمتاجر (islam.wtn4.com …).
#
# **شهادة واحدة تكفي كل المتاجر — الحاضرة والتي لم تُنشأ بعد.** ولهذا لا
# تُفتح Cloudflare عند كل متجر جديد: صفٌّ في القاعدة والعنوان يعمل في نفس
# اللحظة. وسجلّ `*.wtn4.com` موجودٌ هناك من قبلُ.
#
# التحقّق عبر DNS لا HTTP: لا تستطيع Let's Encrypt أن تفتح رابطاً على عنوانٍ
# لم يُخلق بعد، فيكتب Caddy سجلّاً مؤقّتاً بمفتاح Cloudflare ويثبت الملكيّة.
# والمفتاح `CF_API_TOKEN` في `deploy/.env`.
#
# وإن غاب: هذه الكتلة وحدها تفشل في إصدار شهادتها — والموقع الرئيسي فوقها
# يبقى يعمل بشهادته. أي أن نسيان المفتاح يعطّل الميزة ولا يُسقط الموقع.
*.wtn4.com {
	encode zstd gzip

	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	reverse_proxy web:8000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /data/access.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}
