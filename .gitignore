# OS / editor junk
Thumbs.db
Desktop.ini
.DS_Store
*.tmp

# Node (for future build)
node_modules/
dist/
build/
.env
.env.*
!.env.example
# القاعدة `.env.*` أعلاه تبتلع القوالب أيضاً — والقوالب لا أسرار فيها ومكانها
# المستودع، وإلا نُقلت يدوياً في كل نشرٍ ونُسيت.
!*.env.example
!.env.bot.example

# PHP (for future build)
/vendor/

# Logs
*.log

# أسرار النشر — لا تدخل المستودع
deploy/.env
deploy/.env.bot
