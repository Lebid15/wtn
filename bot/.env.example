# انسخ هذا الملف إلى bot/.env واملأ القيم. لا تضعه في git — .gitignore يمنعه.

# عنوان الموقع. محلّياً: http://localhost:8000
SITE_URL=https://wtn.onrender.com

# السرّ المشترك — يجب أن يطابق INTERNAL_API_KEY على الموقع (متغيّرات البيئة في Render).
# ولّد قيمة عشوائية طويلة، ولا تشاركها مع أحد.
INTERNAL_API_KEY=

# مفتاح تشفير مفاتيح جلسات واتساب — ولّده مرّةً بـ: npm run keygen
# احتفظ بنسخة منه: بضياعه تُفقَد الجلسات ويلزم مسح QR من جديد.
BOT_ENCRYPTION_KEY=

# كل كم مللي ثانية يسأل البوت الموقع (3000 = ثلاث ثوانٍ)
POLL_INTERVAL_MS=3000

# سجلّات Baileys: silent | error | info | debug — للتشخيص عند الحاجة
LOG_LEVEL=silent
